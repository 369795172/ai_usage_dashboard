# AI Usage Dashboard local configuration.
# You do not need every data source. Keep values fake in this example file.

# Codex: no key required. The tool reads the default local Codex session directory when present.

# Claude Code: no key required. The tool reads default local Claude Code project logs when present.

# OpenCode: no key required for the main local database. Optional archive support can use opencode_skill.
# Leave empty unless you installed or cloned opencode_skill separately.
AI_USAGE_OPENCODE_SKILL_PATH=../opencode_skill/src

# Optional: path to a second OpenCode server's live DB (e.g. a batch-submission
# server on a different port). When set, its token usage is included in the
# dashboard alongside the main DB. Leave empty if you only run one OpenCode server.
OPENCODE_BATCH_DB=

# Cursor usage export. Paste a browser cookie only in your private .env.
CURSOR_COOKIE=

# GLM / Z.ai usage API token. Paste a real token only in your private .env.
GLM_BEARER_TOKEN=

# Ollama web settings cookie (full browser cookie string from ollama.com/settings).
# Used to fetch the session/weekly quota bars rendered in the settings HTML.
OLLAMA_COOKIE=

# Grok.com browser cookie (full Cookie header from grok.com while logged in).
# Used to fetch the SuperGrok / X Premium weekly usage pool via
# POST /grok_api_v2.GrokBuildBilling/GetGrokCreditsConfig.
# Paste a real cookie only in your private .env — never commit it.
GROK_COOKIE=

# OpenRouter key spend quota (GET /api/v1/key). A normal inference key works
# for the spend bar. A management key is required for /credits and /activity
# per-model activity, which this dashboard does not read yet.
# Paste a real key only in your private .env — never commit it.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-real-key

# Gemini Developer API spend is a local JSONL ledger, not an upstream usage
# API. Google does not expose dollar spend on GEMINI_API_KEY. Leave empty to
# use <rootgrove>/logs/gemini_api_ledger.jsonl when this clone sits under
# rootgrove. Optional monthly budget fills the 30-day remaining/percentage.
GEMINI_API_LEDGER_PATH=
GEMINI_API_BUDGET_USD=

# Volcengine Ark Seedance spend is a local JSONL ledger. Bearer ARK_API_KEY
# cannot query GetInferenceUsage. Leave empty to use
# <rootgrove>/logs/ark_api_ledger.jsonl when this clone sits under rootgrove.
# Optional monthly budget fills the 30-day remaining/percentage.
ARK_API_LEDGER_PATH=
ARK_API_BUDGET_CNY=

# Local display service defaults.
AI_USAGE_HOST=127.0.0.1
AI_USAGE_PORT=7995

# Cross-machine Antigravity push: satellite (laptop) pushes its entries to the
# dashboard host (e.g. over Tailscale). Set this on the satellite only.
# The dashboard host must run the service bound to 0.0.0.0 or a Tailscale interface.
# Example: http://your-host.your-tailnet.ts.net:7995/api/v1/antigravity/ingest
AI_USAGE_DASHBOARD_INGEST_URL=
# Optional satellite label for logging on the host side.
AI_USAGE_SATELLITE_NAME=
